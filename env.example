# ============================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO JWT
# ============================================

# Chave secreta para assinar tokens JWT
# Gere uma chave segura usando: python scripts/generate_secrets.py
JWT_SECRET_KEY=change-me-in-production-use-secure-random-key

# Tempo de expiração do token em minutos (padrão: 1440 = 24 horas)
JWT_EXPIRE_MINUTES=1440

# ============================================
# API KEYS
# ============================================

# API Key padrão (pode ter múltiplas)
# Gere uma chave segura usando: python scripts/generate_secrets.py
API_KEY_1=default-api-key-change-me

# Adicione mais API keys se necessário:
# API_KEY_2=another-secure-api-key
# API_KEY_3=yet-another-secure-api-key

# ============================================
# NOTAS
# ============================================
# 
# 1. NUNCA faça commit deste arquivo com chaves reais
# 2. Copie este arquivo para .env e configure suas chaves
# 3. Use: cp env.example .env
# 4. Adicione .env ao .gitignore (já está adicionado)
# 5. Em produção, use variáveis de ambiente do sistema ou secrets manager

